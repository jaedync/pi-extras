{
  "name": "pi-extras",
  "version": "0.2.1",
  "private": true,
  "description": "Optional status, usage limits, activity, search, shell tools and a quiet theme for Pi",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package"],
  "repository": { "type": "git", "url": "https://github.com/jaedync/pi-extras.git" },
  "engines": { "node": ">=22.18.0" },
  "files": ["extensions/", "lib/", "themes/", "docs/", "licenses/", "README.md", "LICENSE", "THIRD_PARTY.md"],
  "pi": {
    "extensions": ["extensions/status-plus.ts", "extensions/usage-guard.ts", "extensions/phase-spinner.ts", "extensions/shell-jobs.ts", "extensions/bash-default-timeout.ts", "extensions/kagi-search.ts"],
    "themes": ["themes/quiet.json"]
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:unit": "node --test --test-timeout=30000 tests/*.test.ts tests/*.test.mjs tests/*.test.mts",
    "test:kagi": "vitest run",
    "test:install": "node scripts/install-smoke.mjs",
    "audit:package": "node scripts/audit-package.mjs"
  },
  "dependencies": { "node-html-parser": "7.0.2" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.0",
    "@earendil-works/pi-tui": ">=0.87.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0",
    "typebox": "1.1.38",
    "vitest": "5.0.0"
  }
}
