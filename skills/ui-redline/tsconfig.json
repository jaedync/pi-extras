{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": false,
		"target": "es2023",
		"lib": ["es2023", "dom"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"skipLibCheck": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["scripts/**/*.mjs"]
}
